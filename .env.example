# OpenGameEval Local Harness
# Copy this to .env and fill in your values

# Your LLM API base URL (OpenAI-compatible endpoint)
LLM_API_BASE=

# Your LLM API key
LLM_API_KEY=

# Studio paths (Windows) — optional, can also pass via CLI
# STUDIO_EXE=C:\Users\YOU\AppData\Local\Roblox\Versions\version-xxx\RobloxStudioBeta.exe
# MCP_BAT=C:\Users\YOU\AppData\Local\Roblox\mcp.bat
